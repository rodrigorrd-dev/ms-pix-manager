{
  "name": "pix-outbox-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "pix",
    "database.password": "pix_local_only",
    "database.dbname": "pixmanager",
    "topic.prefix": "pixdb",
    "plugin.name": "pgoutput",
    "slot.name": "pix_outbox_slot",
    "publication.name": "pix_outbox_pub",
    "publication.autocreate.mode": "disabled",
    "table.include.list": "public.outbox_event",
    "snapshot.mode": "no_data",
    "heartbeat.interval.ms": "10000",
    "tombstones.on.delete": "false",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.converters.ByteArrayConverter",
    "transforms": "dropHeartbeat,outbox",
    "transforms.dropHeartbeat.type": "org.apache.kafka.connect.transforms.Filter",
    "transforms.dropHeartbeat.predicate": "isHeartbeat",
    "predicates": "isHeartbeat",
    "predicates.isHeartbeat.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
    "predicates.isHeartbeat.pattern": "__debezium-heartbeat.*",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.table.field.event.id": "id",
    "transforms.outbox.table.field.event.key": "aggregate_id",
    "transforms.outbox.table.field.event.payload": "payload",
    "transforms.outbox.route.by.field": "aggregate_type",
    "transforms.outbox.route.topic.replacement": "pix.${routedByValue}.v1",
    "transforms.outbox.table.fields.additional.placement": "event_type:header:eventType,trace_parent:header:traceparent,event_version:header:eventVersion",
    "transforms.outbox.table.expand.json.payload": "false",
    "errors.tolerance": "none",
    "producer.override.acks": "all",
    "producer.override.enable.idempotence": "true",
    "producer.override.compression.type": "lz4"
  }
}
