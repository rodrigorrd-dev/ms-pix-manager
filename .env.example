# =============================================================================
# ms-pix-manager — configuração por ambiente (modelo versionado)
#
#   cp .env.example .env     # o .env real NÃO é versionado (.gitignore)
#
# Quem lê este arquivo:
#   • a aplicação  — application.yml importa ./.env automaticamente (spring.config.import);
#                    variável já definida no ambiente do SO/IDE tem prioridade sobre o .env
#   • o Docker     — docker compose up -d --build   (lê o .env da raiz sozinho)
#   • os scripts   — docker/debezium/register-connector.sh (modo manual, com o app na IDE)
#
# As variáveis aqui estão do ponto de vista do HOST (app na IDE). Com `docker compose up`, o serviço `app`
# sobrescreve só o que muda na rede interna (DB_URL, Kafka, Schema Registry, JWKS, OTLP).
#
# Valores abaixo = ambiente LOCAL de desenvolvimento (os mesmos defaults do código).
# Em hml/prd NUNCA use estes segredos: injete pelo cofre/orquestrador.
# =============================================================================


# ----------------------------------------------------------------------------
# Aplicação
# ----------------------------------------------------------------------------
APP_NAME=ms-pix-manager
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8088
# porta publicada no host pelo container `app`
APP_PORT=8088
MANAGEMENT_ENDPOINTS=health,info,prometheus
SWAGGER_ENABLED=true
SPRINGWOLF_ENABLED=true
PIX_DOCS_PUBLIC=true

# Instituição (ISPB: 8 dígitos; obrigatório fora do perfil local)
PIX_ISPB=12345678
PIX_INSTITUTION_NAME=Instituição
PIX_ERROR_BASE_TYPE_URI=https://errors.pixmanager.example/


# ----------------------------------------------------------------------------
# Banco de dados (PostgreSQL) — a mesma fonte alimenta app e container
# ----------------------------------------------------------------------------
POSTGRES_DB=pixmanager
POSTGRES_USER=pix
POSTGRES_PASSWORD=pix_local_only
POSTGRES_BIND=127.0.0.1
POSTGRES_HOST_PORT=55432

DB_URL=jdbc:postgresql://localhost:55432/pixmanager
DB_USERNAME=pix
DB_PASSWORD=pix_local_only
DB_POOL_MAX=30
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT_MS=3000
JPA_DDL_AUTO=validate
JPA_BATCH_SIZE=50
JPA_SHOW_SQL=false
LIQUIBASE_ENABLED=true


# ----------------------------------------------------------------------------
# Kafka / Schema Registry / Debezium
# ----------------------------------------------------------------------------
KAFKA_EXTERNAL_PORT=19094
KAFKA_BOOTSTRAP_SERVERS=localhost:19094
KAFKA_CONSUMER_GROUP=ms-pix-manager
KAFKA_AUTO_REGISTER_SCHEMAS=true
KAFKA_AUTO_CREATE_RETRY_TOPICS=true

# Retry não bloqueante dos consumers (backoff exponencial com jitter)
KAFKA_RETRY_ATTEMPTS=4
KAFKA_RETRY_DELAY_MS=5000
KAFKA_RETRY_MULTIPLIER=6
KAFKA_RETRY_MAX_DELAY_MS=180000

SCHEMA_REGISTRY_PORT=18081
SCHEMA_REGISTRY_URL=http://localhost:18081

CONNECT_PORT=18083
CONNECT_URL=http://localhost:18083
# Conector de outbox: como o Kafka Connect (DENTRO da rede do compose) enxerga o Postgres
CONNECTOR_DB_HOST=postgres
CONNECTOR_DB_PORT=5432


# ----------------------------------------------------------------------------
# Segurança do Kafka / Schema Registry (dev = PLAINTEXT; hml/prd = SASL_SSL, credenciais SÓ pelo cofre)
# ----------------------------------------------------------------------------
# Protocolo: PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL (recomendado em prd: o tópico de Pix recebido leva CPF/CNPJ em claro)
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# SASL (só com SASL_*): SCRAM-SHA-512 | PLAIN | OAUTHBEARER, e o JAAS com usuário/senha do app
KAFKA_SASL_MECHANISM=
KAFKA_SASL_JAAS_CONFIG=
# TLS com CA PRIVADA: preencha SÓ junto do profile kafka-tls (truststore) e kafka-mtls (keystore); em branco = truststore padrão da JVM.
# Ex.: SPRING_PROFILES_ACTIVE=prd,kafka-tls  (com o profile ativo, variável faltando = o app não sobe)
KAFKA_SSL_TRUSTSTORE_LOCATION=
KAFKA_SSL_TRUSTSTORE_PASSWORD=
KAFKA_SSL_TRUSTSTORE_TYPE=
KAFKA_SSL_KEYSTORE_LOCATION=
KAFKA_SSL_KEYSTORE_PASSWORD=
KAFKA_SSL_KEYSTORE_TYPE=
KAFKA_SSL_KEY_PASSWORD=
# Schema Registry com Basic Auth: "usuario:senha" (vazio = sem autenticação, como no dev)
SCHEMA_REGISTRY_USER_INFO=


# ----------------------------------------------------------------------------
# Rotação de chave, outbox, métricas e retry (veja docs/runbooks e subida-producao.md)
# ----------------------------------------------------------------------------
# Rotação da chave AES (runbook rotacao-de-chave.md): chaves ANTIGAS só para decifrar; a versão é o sufixo (V1, V2, V3). Vazio = sem chave antiga.
PIX_CRYPTO_PREVIOUS_AES_KEYS_V1=
PIX_CRYPTO_PREVIOUS_AES_KEYS_V2=
PIX_CRYPTO_PREVIOUS_AES_KEYS_V3=
# true = re-criptografa em lote no start. Ligue em UMA instância, espere o log "re-criptografia concluída" e desligue.
PIX_CRYPTO_REENCRYPT=false
PIX_CRYPTO_REENCRYPT_BATCH=500
# Linhas da outbox_event mais antigas que isto são apagadas (o Debezium lê o WAL, não a tabela). Formato ISO-8601.
PIX_OUTBOX_RETENTION=P7D
PIX_OUTBOX_CLEANUP_DELAY=PT10M
# Após quanto tempo sem avançar uma ordem/chave/reserva conta como PRESA nas métricas e alertas
PIX_METRICS_STUCK_AFTER=PT5M
# Partições dos tópicos de retry (-retry-N): >= partições do tópico principal (o retry publica na MESMA partição)
KAFKA_RETRY_PARTITIONS=12
# Porta do actuator (health/info/prometheus) em hml/prd; em dev o actuator fica na mesma porta do app
MANAGEMENT_SERVER_PORT=8081


# ----------------------------------------------------------------------------
# Prova de posse (OTP) de chaves e-mail/telefone
# ----------------------------------------------------------------------------
# none = padrão SEGURO (sem canal: a prova de posse responde 503) | http = serviço de notificação externo | log = SÓ dev, escreve o código no log
PIX_OTP_SENDER=http
# no dev o serviço `mocks` faz o papel do serviço de notificação (e `GET /otp/v1/last?destination=` devolve o código para testes)
PIX_OTP_GATEWAY_URL=http://localhost:18090

# ----------------------------------------------------------------------------
# Integrações externas (dict-gateway e core bancário/ledger)
# ----------------------------------------------------------------------------
# dict-gateway e core-ledger NÃO fazem parte deste repositório. Em dev o serviço `mocks` do compose (docker/mocks) responde pelos dois
# na porta MOCKS_PORT; no compose o app usa http://mocks:8080. Para usar os reais: aponte aqui e, p/ o compose, DICT_GATEWAY_URL_COMPOSE / CORE_LEDGER_URL_COMPOSE.
MOCKS_PORT=18090
DICT_GATEWAY_URL=http://localhost:18090
DICT_CONNECT_TIMEOUT=500ms
DICT_READ_TIMEOUT=3s
DICT_SWEEPER_DELAY=PT3S

CORE_LEDGER_URL=http://localhost:18090
CORE_LEDGER_CONNECT_TIMEOUT=500ms
CORE_LEDGER_READ_TIMEOUT=2s
CORE_LEDGER_SWEEPER_DELAY=PT2S

# Host/caminho público do QR dinâmico (payload do BR Code)
PIX_QR_BASE_URL=pix.example.com/qr/v2/


# ----------------------------------------------------------------------------
# Segurança (Resource Server: o ms só VALIDA o JWT)
# ----------------------------------------------------------------------------
KEYCLOAK_PORT=18180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_local_only
OAUTH2_JWKS_URI=http://localhost:18180/realms/pix/protocol/openid-connect/certs
OAUTH2_ISSUER_URI=http://localhost:18180/realms/pix
OAUTH2_AUDIENCE=

# Criptografia de PII (32 bytes em base64, DISTINTAS entre si). As abaixo são SÓ de dev.
# Gerar chaves novas:  openssl rand -base64 32
PIX_CRYPTO_AES_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
PIX_CRYPTO_HMAC_KEY=ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8=
PIX_CRYPTO_KEY_VERSION=v1


# ----------------------------------------------------------------------------
# Observabilidade
# ----------------------------------------------------------------------------
TRACING_SAMPLING=1.0
OTLP_TRACES_ENDPOINT=http://localhost:14318/v1/traces

OTEL_GRPC_PORT=14317
OTEL_HTTP_PORT=14318
LOKI_PORT=13100
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
KAFKA_UI_PORT=18080
KAFKA_EXPORTER_PORT=19308


# ----------------------------------------------------------------------------
# Caminhos montados nos containers (relativos à RAIZ do projeto, ou absolutos)
# ----------------------------------------------------------------------------
PG_INIT_DIR=./docker/init
KEYCLOAK_REALM_FILE=./docker/keycloak/realm-pix.json
OTEL_CONFIG_FILE=./ops/otel/config.yaml
TEMPO_CONFIG_FILE=./ops/tempo/tempo.yaml
PROMETHEUS_CONFIG_FILE=./ops/prometheus/prometheus.yml
PROMETHEUS_ALERTS_FILE=./ops/prometheus/alert-rules.yml
# Prometheus raspa `app:8080` (container). App na IDE? Troque o alvo em ops/prometheus/prometheus.yml por host.docker.internal:<SERVER_PORT>.
